generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum RoleKey {
  SUPER_ADMIN
  OWNER_ADMIN
  BOOKING_SALES
  OPERATIONS
  CONTENT_SEO
  FINANCE
  AUDITOR
  CUSTOMER
}

enum ContentStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum DestinationKind {
  CITY
  TEMPLE
  NATURE
  HERITAGE
  REGION
}

enum FaqScope {
  GENERAL
  BOOKING
  PRICING
  CANCELLATION
  VEHICLES
  PACKAGES
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  RETIRED
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  SUSPENDED
}

enum PricingRuleStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TripType {
  ONE_WAY
  ROUND_TRIP
  MULTI_CITY
}

enum PricingBasis {
  PER_KM
  FIXED
  QUOTE_ONLY
}

enum BookingStatus {
  DRAFT
  PENDING_PAYMENT
  PENDING_REVIEW
  CONFIRMED
  DRIVER_ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum BookingPolicyStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum PackagePriceMode {
  PER_PERSON
  PER_VEHICLE
  PER_GROUP
  FIXED
}


enum LeadType {
  CONTACT
  CUSTOM_TRIP
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  QUALIFIED
  CLOSED
  SPAM
}

enum PaymentProvider {
  RAZORPAY
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
  CANCELLED
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  emailNormalized String      @unique
  passwordHash    String?
  name            String?
  phone           String?
  status          UserStatus  @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  roles           UserRole[]  @relation("UserRoles")
  assignedRoles   UserRole[]  @relation("AssignedRoles")
  sessions        Session[]
  auditLogs       AuditLog[]  @relation("AuditActor")
  carBookings     CarBooking[] @relation("CustomerBookings")
  bookingChanges  BookingStatusHistory[] @relation("BookingStatusActor")
  packageBookings       PackageBooking[] @relation("CustomerPackageBookings")
  packageBookingChanges PackageBookingStatusHistory[] @relation("PackageBookingStatusActor")

  @@index([status])
  @@index([createdAt])
}

model Role {
  id        String     @id @default(cuid())
  key       RoleKey    @unique
  label     String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  users     UserRole[]
}

model UserRole {
  userId       String
  roleId       String
  assignedById String?
  assignedAt   DateTime @default(now())

  user       User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("AssignedRoles", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedById])
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime?
  ipHash     String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  requestId   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model MediaAsset {
  id              String   @id @default(cuid())
  storageProvider String
  bucket          String?
  objectKey       String   @unique
  publicUrl       String?
  mimeType        String
  byteSize        BigInt?
  width           Int?
  height          Int?
  altText         String?
  caption         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cmsPageHeroes    CmsPage[]     @relation("CmsPageHero")
  destinationHero Destination[]   @relation("DestinationHero")
  blogPostHeroes  BlogPost[]     @relation("BlogPostHero")
  vehicleMedia    VehicleMedia[]
  packageHeroes   TourPackage[] @relation("PackageHero")

  @@index([mimeType])
  @@index([createdAt])
}

model CmsPage {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String?
  body           Json
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  scheduledFor   DateTime?
  heroMediaId    String?
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  robotsIndex    Boolean       @default(true)
  robotsFollow   Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  heroMedia MediaAsset? @relation("CmsPageHero", fields: [heroMediaId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([scheduledFor])
}

model Destination {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  kind           DestinationKind
  summary        String?
  body           Json
  status         ContentStatus   @default(DRAFT)
  isFeatured     Boolean         @default(false)
  publishedAt    DateTime?
  scheduledFor   DateTime?
  heroMediaId    String?
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  robotsIndex    Boolean         @default(true)
  robotsFollow   Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  heroMedia     MediaAsset?    @relation("DestinationHero", fields: [heroMediaId], references: [id], onDelete: SetNull)
  templeProfile TempleProfile?
  packageLinks   PackageDestination[]

  @@index([kind, status, publishedAt])
  @@index([isFeatured, status])
  @@index([scheduledFor])
}

model TempleProfile {
  id             String      @id @default(cuid())
  destinationId  String      @unique
  templeName     String
  deity          String?
  darshanNotes   String?
  dressCode      String?
  openingHours   Json?
  nearbyPlaces   Json?
  practicalNotes Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
}

model BlogCategory {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  posts       BlogPost[]
}

model BlogPost {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String?
  body           Json
  status         ContentStatus @default(DRAFT)
  categoryId     String?
  heroMediaId    String?
  publishedAt    DateTime?
  scheduledFor   DateTime?
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  robotsIndex    Boolean       @default(true)
  robotsFollow   Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category  BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  heroMedia MediaAsset?   @relation("BlogPostHero", fields: [heroMediaId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([scheduledFor])
}

model Faq {
  id           String        @id @default(cuid())
  scope        FaqScope      @default(GENERAL)
  question     String
  answer       String
  sortOrder    Int           @default(0)
  status       ContentStatus @default(DRAFT)
  publishedAt  DateTime?
  scheduledFor DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([scope, status, sortOrder])
  @@index([scheduledFor])
}

model ContentRevision {
  id         BigInt   @id @default(autoincrement())
  entityType String
  entityId   String
  version    Int
  payload    Json
  createdBy  String?
  createdAt  DateTime @default(now())

  @@unique([entityType, entityId, version])
  @@index([entityType, entityId, createdAt])
}

model SeoRedirect {
  id              String   @id @default(cuid())
  sourcePath      String   @unique
  destinationPath String
  statusCode      Int      @default(301)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
}


model VehicleClass {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  description    String?
  defaultSeats   Int
  defaultLuggage Int?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vehicles             Vehicle[]
  pricingRules         PricingRule[]
  driverQualifications DriverVehicleClass[]
  quotes               CarQuote[]
  bookings             CarBooking[]
  packagePriceOptions  PackagePriceOption[]

  @@index([isActive, sortOrder])
}

model Vehicle {
  id                 String        @id @default(cuid())
  slug               String        @unique
  registrationNumber String        @unique
  displayName        String
  vehicleClassId     String
  status             VehicleStatus @default(ACTIVE)
  seats              Int
  luggage            Int?
  airConditioned     Boolean       @default(true)
  features           Json?
  description        String?
  isFeatured         Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  vehicleClass VehicleClass               @relation(fields: [vehicleClassId], references: [id], onDelete: Restrict)
  media        VehicleMedia[]
  availability VehicleAvailabilityBlock[]
  bookings     CarBooking[] @relation("AssignedVehicleBookings")

  @@index([vehicleClassId, status])
  @@index([isFeatured, status])
}

model VehicleMedia {
  vehicleId String
  mediaId   String
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  vehicle Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([vehicleId, mediaId])
  @@index([mediaId])
  @@index([vehicleId, isPrimary])
}

model Driver {
  id                      String       @id @default(cuid())
  displayName             String
  status                  DriverStatus @default(ACTIVE)
  phoneCiphertext         String?
  phoneLast4              String?
  licenseNumberCiphertext String?
  licenseExpiry           DateTime?
  internalNotes           String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  qualifications DriverVehicleClass[]
  availability   DriverAvailabilityBlock[]
  bookings       CarBooking[] @relation("AssignedDriverBookings")

  @@index([status])
  @@index([licenseExpiry])
}

model DriverVehicleClass {
  driverId       String
  vehicleClassId String
  approvedAt     DateTime @default(now())

  driver       Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleClass VehicleClass @relation(fields: [vehicleClassId], references: [id], onDelete: Cascade)

  @@id([driverId, vehicleClassId])
  @@index([vehicleClassId])
}

model VehicleAvailabilityBlock {
  id        String   @id @default(cuid())
  vehicleId String
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, startsAt, endsAt])
}

model DriverAvailabilityBlock {
  id        String   @id @default(cuid())
  driverId  String
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, startsAt, endsAt])
}

model PricingRule {
  id                         String            @id @default(cuid())
  name                       String
  vehicleClassId             String
  tripType                   TripType
  basis                      PricingBasis
  currency                   String            @default("INR")
  baseAmountMinor            BigInt?
  perKmMinor                 BigInt?
  minimumDistanceKm          Int?
  driverAllowancePerDayMinor BigInt?
  nightAllowanceMinor        BigInt?
  originKey                  String?
  destinationKey             String?
  priority                   Int               @default(0)
  status                     PricingRuleStatus @default(DRAFT)
  activeFrom                 DateTime?
  activeTo                   DateTime?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  vehicleClass VehicleClass @relation(fields: [vehicleClassId], references: [id], onDelete: Restrict)
  quotes       CarQuote[]
  bookings     CarBooking[]

  @@index([vehicleClassId, tripType, status, priority])
  @@index([originKey, destinationKey])
  @@index([activeFrom, activeTo])
}


model CarQuote {
  id              String   @id @default(cuid())
  tripType        TripType
  originText      String
  destinationText String
  startsAt        DateTime
  endsAt          DateTime?
  travellers      Int
  vehicleClassId  String
  pricingRuleId   String?
  currency        String   @default("INR")
  subtotalMinor   BigInt
  discountMinor   BigInt   @default(0)
  taxMinor        BigInt   @default(0)
  totalMinor      BigInt
  priceBreakdown  Json
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  vehicleClass VehicleClass @relation(fields: [vehicleClassId], references: [id], onDelete: Restrict)
  pricingRule  PricingRule? @relation(fields: [pricingRuleId], references: [id], onDelete: SetNull)
  booking      CarBooking?

  @@index([vehicleClassId, startsAt])
  @@index([tripType])
  @@index([expiresAt])
}

model CarBooking {
  id                   String        @id @default(cuid())
  reference            String        @unique
  quoteId              String?       @unique
  idempotencyKey       String        @unique
  requestFingerprint   String
  status               BookingStatus @default(DRAFT)
  tripType             TripType
  originText           String
  destinationText      String
  startsAt             DateTime
  endsAt               DateTime?
  travellers           Int
  customerUserId       String?
  guestName            String?
  guestEmail           String?
  guestPhoneCiphertext String?
  vehicleClassId       String
  selectedVehicleId    String?
  assignedDriverId     String?
  pricingRuleId        String?
  currency             String        @default("INR")
  subtotalMinor        BigInt
  discountMinor        BigInt        @default(0)
  taxMinor             BigInt        @default(0)
  totalMinor           BigInt
  priceSnapshot        Json
  policySnapshot       Json
  bookingPolicyVersionId String?
  expiresAt            DateTime?
  confirmedAt          DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  quote           CarQuote?     @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  customer        User?         @relation("CustomerBookings", fields: [customerUserId], references: [id], onDelete: SetNull)
  vehicleClass    VehicleClass  @relation(fields: [vehicleClassId], references: [id], onDelete: Restrict)
  selectedVehicle Vehicle?      @relation("AssignedVehicleBookings", fields: [selectedVehicleId], references: [id], onDelete: SetNull)
  assignedDriver  Driver?       @relation("AssignedDriverBookings", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  pricingRule     PricingRule?  @relation(fields: [pricingRuleId], references: [id], onDelete: SetNull)
  bookingPolicy   BookingPolicyVersion? @relation(fields: [bookingPolicyVersionId], references: [id], onDelete: SetNull)
  statusHistory   BookingStatusHistory[]
  paymentIntents  PaymentIntent[] @relation("CarBookingPayments")

  @@index([status, startsAt])
  @@index([customerUserId, createdAt])
  @@index([selectedVehicleId, startsAt])
  @@index([assignedDriverId, startsAt])
  @@index([vehicleClassId, startsAt])
  @@index([bookingPolicyVersionId])
}

model BookingStatusHistory {
  id          BigInt        @id @default(autoincrement())
  bookingId   String
  fromStatus  BookingStatus?
  toStatus    BookingStatus
  actorUserId String?
  reason      String?
  metadata    Json?
  createdAt   DateTime      @default(now())

  booking CarBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User?      @relation("BookingStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([actorUserId, createdAt])
}


model BookingPolicyVersion {
  id            String              @id @default(cuid())
  code          String
  version       Int
  status        BookingPolicyStatus @default(DRAFT)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  document      Json
  activatedAt   DateTime?
  retiredAt     DateTime?
  createdBy     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  bookings        CarBooking[]
  packageBookings PackageBooking[]

  @@unique([code, version])
  @@index([code, status, effectiveFrom, effectiveTo])
}


model TourPackage {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  summary        String?
  body           Json
  status         ContentStatus @default(DRAFT)
  durationDays   Int
  durationNights Int
  heroMediaId    String?
  publishedAt    DateTime?
  scheduledFor   DateTime?
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  robotsIndex    Boolean       @default(true)
  robotsFollow   Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  heroMedia      MediaAsset?          @relation("PackageHero", fields: [heroMediaId], references: [id], onDelete: SetNull)
  destinations   PackageDestination[]
  itinerary      PackageItineraryDay[]
  priceOptions   PackagePriceOption[]
  quotes         PackageQuote[]
  bookings       PackageBooking[]

  @@index([status, publishedAt])
  @@index([scheduledFor])
}

model PackageDestination {
  packageId     String
  destinationId String
  sortOrder     Int @default(0)

  package     TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  @@id([packageId, destinationId])
  @@index([destinationId])
}

model PackageItineraryDay {
  id          String @id @default(cuid())
  packageId   String
  dayNumber   Int
  title       String
  description String?
  body        Json?

  package TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, dayNumber])
  @@index([packageId, dayNumber])
}

model PackagePriceOption {
  id             String           @id @default(cuid())
  packageId      String
  mode           PackagePriceMode
  currency       String           @default("INR")
  amountMinor    BigInt
  vehicleClassId String?
  minTravellers  Int?
  maxTravellers  Int?
  isActive       Boolean          @default(true)
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  package      TourPackage  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  vehicleClass VehicleClass? @relation(fields: [vehicleClassId], references: [id], onDelete: Restrict)
  quotes       PackageQuote[]
  bookings     PackageBooking[]

  @@index([packageId, isActive, sortOrder])
  @@index([vehicleClassId])
}

model PackageQuote {
  id             String   @id @default(cuid())
  packageId      String
  priceOptionId  String
  travellers     Int
  vehicleCount   Int?
  quantity       Int
  travelStartAt  DateTime
  currency       String   @default("INR")
  subtotalMinor  BigInt
  discountMinor  BigInt   @default(0)
  taxMinor       BigInt   @default(0)
  totalMinor     BigInt
  priceBreakdown Json
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  package     TourPackage        @relation(fields: [packageId], references: [id], onDelete: Restrict)
  priceOption PackagePriceOption @relation(fields: [priceOptionId], references: [id], onDelete: Restrict)
  booking     PackageBooking?

  @@index([packageId, travelStartAt])
  @@index([priceOptionId])
  @@index([expiresAt])
}

model PackageBooking {
  id                     String        @id @default(cuid())
  reference              String        @unique
  quoteId                String?       @unique
  idempotencyKey         String        @unique
  requestFingerprint     String
  status                 BookingStatus @default(DRAFT)
  packageId              String
  priceOptionId          String?
  travellers             Int
  vehicleCount           Int?
  travelStartAt          DateTime
  customerUserId         String?
  guestName              String?
  guestEmail             String?
  guestPhoneCiphertext   String?
  currency               String        @default("INR")
  subtotalMinor          BigInt
  discountMinor          BigInt        @default(0)
  taxMinor               BigInt        @default(0)
  totalMinor             BigInt
  packageSnapshot        Json
  priceSnapshot          Json
  policySnapshot         Json
  bookingPolicyVersionId String?
  confirmedAt            DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  quote         PackageQuote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  package       TourPackage           @relation(fields: [packageId], references: [id], onDelete: Restrict)
  priceOption   PackagePriceOption?   @relation(fields: [priceOptionId], references: [id], onDelete: SetNull)
  customer      User?                 @relation("CustomerPackageBookings", fields: [customerUserId], references: [id], onDelete: SetNull)
  bookingPolicy BookingPolicyVersion? @relation(fields: [bookingPolicyVersionId], references: [id], onDelete: SetNull)
  statusHistory PackageBookingStatusHistory[]
  paymentIntents PaymentIntent[] @relation("PackageBookingPayments")

  @@index([status, travelStartAt])
  @@index([packageId, travelStartAt])
  @@index([customerUserId, createdAt])
  @@index([bookingPolicyVersionId])
}


model PackageBookingStatusHistory {
  id          BigInt        @id @default(autoincrement())
  bookingId   String
  fromStatus  BookingStatus?
  toStatus    BookingStatus
  actorUserId String?
  reason      String?
  metadata    Json?
  createdAt   DateTime      @default(now())

  booking PackageBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User?          @relation("PackageBookingStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([actorUserId, createdAt])
}



model Lead {
  id              String     @id @default(cuid())
  reference       String     @unique
  type            LeadType
  status          LeadStatus @default(NEW)
  idempotencyKey  String     @unique
  name            String
  email           String
  emailNormalized String
  phone           String?
  message         String?
  tripData        Json?
  sourcePath      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([type, status, createdAt])
  @@index([emailNormalized, createdAt])
}

model PaymentIntent {
  id                String          @id @default(cuid())
  provider          PaymentProvider @default(RAZORPAY)
  status            PaymentStatus   @default(CREATED)
  idempotencyKey    String          @unique
  carBookingId      String?
  packageBookingId  String?
  providerOrderId   String?         @unique
  providerPaymentId String?         @unique
  currency          String          @default("INR")
  amountMinor       BigInt
  amountPaidMinor   BigInt          @default(0)
  receipt           String?
  authorizedAt      DateTime?
  capturedAt        DateTime?
  failedAt          DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  carBooking     CarBooking?      @relation("CarBookingPayments", fields: [carBookingId], references: [id], onDelete: Restrict)
  packageBooking PackageBooking?  @relation("PackageBookingPayments", fields: [packageBookingId], references: [id], onDelete: Restrict)
  webhookEvents  PaymentWebhookEvent[]
  refunds        Refund[]

  @@index([carBookingId, createdAt])
  @@index([packageBookingId, createdAt])
  @@index([status, createdAt])
}

model PaymentWebhookEvent {
  id                  BigInt          @id @default(autoincrement())
  provider            PaymentProvider @default(RAZORPAY)
  dedupeKey           String
  eventType           String
  payload             Json
  signatureVerifiedAt DateTime
  paymentIntentId     String?
  receivedAt          DateTime        @default(now())
  processedAt         DateTime?
  processingError     String?

  paymentIntent PaymentIntent? @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)

  @@unique([provider, dedupeKey])
  @@index([paymentIntentId, receivedAt])
  @@index([eventType, receivedAt])
  @@index([processedAt])
}

model Refund {
  id               String          @id @default(cuid())
  paymentIntentId  String
  provider         PaymentProvider @default(RAZORPAY)
  status           RefundStatus    @default(PENDING)
  idempotencyKey   String          @unique
  providerRefundId String?         @unique
  currency         String          @default("INR")
  amountMinor      BigInt
  reason           String?
  processedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)

  @@index([paymentIntentId, createdAt])
  @@index([status, createdAt])
}
