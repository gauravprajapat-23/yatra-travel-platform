# PUBLIC ROUTING (server-rendered configuration)
APP_URL=http://localhost:3000
SUPPORT_EMAIL=

# OPTIONAL ANALYTICS
# Google Analytics measurement ID is not a secret. Analytics loads only after consent.
GA_MEASUREMENT_ID=

# DATABASE (server only)
DATABASE_URL=

# AUTH (server only)
AUTH_SECRET=
# Keep false until customer email verification delivery is available and certified.
CUSTOMER_AUTH_WRITE_ENABLED=false
# Keep false until a real password-reset delivery drill passes.
CUSTOMER_PASSWORD_RESET_ENABLED=false
# Base64-encoded 32-byte key for AES-256-GCM field encryption.
FIELD_ENCRYPTION_KEY=

# BOOKING (server only)
# Keep false until the relevant active booking policy is configured and launch gates pass.
BOOKING_WRITE_ENABLED=false
PACKAGE_BOOKING_WRITE_ENABLED=false
# Keep false until a constrained production promotion has passed preview + booking redemption drills.
PROMOTION_APPLY_ENABLED=false

# PAYMENTS (server only)
# Keep provider mutations disabled until test-mode drills pass.
PAYMENT_WRITE_ENABLED=false
REFUND_WRITE_ENABLED=false

# STORAGE (server only)
# Keep false until the storage connectivity/upload-delete drill passes.
MEDIA_WRITE_ENABLED=false
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# PAYMENT PROVIDER (server only)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# NOTIFICATIONS (server only)
# Customer verification/password-reset email flow currently supports Resend.
NOTIFICATION_EMAIL_PROVIDER=resend
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=

# Reserved provider selections for future/non-launch notification channels.
SMS_PROVIDER=
WHATSAPP_PROVIDER=

# OBSERVABILITY
SENTRY_DSN=

# SCHEDULER (server only)
# Random secret (16+ chars) used to authenticate scheduled publication jobs.
CRON_SECRET=
