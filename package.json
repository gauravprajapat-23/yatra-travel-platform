{
  "name": "yatra-travel-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "dev": "npm run dev -w @yatra/web",
    "build": "npm run build -w @yatra/web",
    "lint": "npm run lint -w @yatra/web",
    "typecheck": "npm run typecheck -w @yatra/web",
    "typecheck:domain": "npm run typecheck -w @yatra/domain",
    "typecheck:providers": "npm run typecheck -w @yatra/providers",
    "test:domain": "npm run test -w @yatra/domain",
    "test:providers": "npm run test -w @yatra/providers",
    "db:generate": "npm run db:generate -w @yatra/db",
    "db:validate": "npm run db:validate -w @yatra/db",
    "check": "npm run lint && npm run typecheck && npm run typecheck:domain && npm run typecheck:providers && npm run test:domain && npm run test:providers && npm run db:validate && npm run build",
    "admin:bootstrap": "npm run db:bootstrap:admin -w @yatra/db",
    "verify:production": "node scripts/verify-production-readiness.mjs",
    "verify:admin-routes": "node scripts/verify-admin-route-protection.mjs",
    "verify:admin-authenticated": "node scripts/verify-admin-authenticated-runtime.mjs",
    "verify:admin-accessibility": "node scripts/verify-admin-accessibility-runtime.mjs",
    "verify:admin-forms": "node scripts/verify-admin-form-system.mjs",
    "verify:staff-invites": "node scripts/verify-staff-invite-runtime.mjs",
    "verify:payment-runtime": "node scripts/verify-payment-runtime-safety.mjs",
    "test:e2e": "playwright test",
    "verify:customer-auth": "node scripts/verify-customer-auth-safety.mjs",
    "verify:notifications": "node scripts/verify-notification-foundation.mjs",
    "verify:promotions": "node scripts/verify-promotion-runtime-safety.mjs",
    "verify:production-health": "node scripts/verify-production-health-contract.mjs",
    "certify:production-runtime": "node scripts/certify-production-runtime.mjs",
    "verify:observability": "node scripts/verify-observability-safety.mjs",
    "verify:public-seo": "node scripts/verify-public-seo-safety.mjs",
    "verify:production-readiness-workflow": "node scripts/verify-production-readiness-workflow.mjs",
    "verify:runtime-inputs": "node scripts/verify-runtime-certifier-inputs.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
